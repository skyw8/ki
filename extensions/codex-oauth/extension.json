{
  "name": "codex-oauth",
  "version": "0.1.0",
  "description": "OpenAI Codex subscription provider with ChatGPT OAuth",
  "capabilities": ["provider"],
  "providers": [
    {
      "id": "openai-codex",
      "name": "OpenAI Codex",
      "api": "openai-codex-responses",
      "baseUrl": "https://chatgpt.com/backend-api",
      "auth": {
        "type": "oauth",
        "name": "OpenAI (ChatGPT Plus/Pro)",
        "subscription": true
      },
      "defaultModel": "gpt-5.4",
      "models": [
        {
          "id": "gpt-5.3-codex-spark",
          "name": "GPT-5.3 Codex Spark",
          "contextWindow": 128000,
          "maxTokens": 128000,
          "input": ["text"],
          "applyPatchToolType": "freeform",
          "reasoning": true,
          "thinkingLevelMap": {"xhigh": "xhigh"},
          "cost": {"input": 1.75, "output": 14, "cacheRead": 0.175, "cacheWrite": 0}
        },
        {
          "id": "gpt-5.4",
          "name": "GPT-5.4",
          "contextWindow": 272000,
          "maxTokens": 128000,
          "input": ["text", "image"],
          "applyPatchToolType": "freeform",
          "reasoning": true,
          "thinkingLevelMap": {"xhigh": "xhigh"},
          "cost": {"input": 2.5, "output": 15, "cacheRead": 0.25, "cacheWrite": 0, "tiers": [{"inputTokensAbove": 272000, "input": 5, "output": 22.5, "cacheRead": 0.5, "cacheWrite": 0}]}
        },
        {
          "id": "gpt-5.4-mini",
          "name": "GPT-5.4 mini",
          "contextWindow": 272000,
          "maxTokens": 128000,
          "input": ["text", "image"],
          "applyPatchToolType": "freeform",
          "reasoning": true,
          "thinkingLevelMap": {"xhigh": "xhigh"},
          "cost": {"input": 0.75, "output": 4.5, "cacheRead": 0.075, "cacheWrite": 0}
        },
        {
          "id": "gpt-5.5",
          "name": "GPT-5.5",
          "contextWindow": 272000,
          "maxTokens": 128000,
          "input": ["text", "image"],
          "applyPatchToolType": "freeform",
          "reasoning": true,
          "thinkingLevelMap": {"xhigh": "xhigh"},
          "cost": {"input": 5, "output": 30, "cacheRead": 0.5, "cacheWrite": 0, "tiers": [{"inputTokensAbove": 272000, "input": 10, "output": 45, "cacheRead": 1, "cacheWrite": 0}]}
        },
        {
          "id": "gpt-5.6-luna",
          "name": "GPT-5.6 Luna",
          "contextWindow": 272000,
          "maxTokens": 128000,
          "input": ["text", "image"],
          "applyPatchToolType": "freeform",
          "reasoning": true,
          "thinkingLevelMap": {"off": null, "minimal": "low", "xhigh": "xhigh", "max": "max"},
          "cost": {"input": 0.2, "output": 1.2, "cacheRead": 0.02, "cacheWrite": 0.25, "tiers": [{"inputTokensAbove": 272000, "input": 0.4, "output": 1.8, "cacheRead": 0.04, "cacheWrite": 0.5}]}
        },
        {
          "id": "gpt-5.6-sol",
          "name": "GPT-5.6 Sol",
          "contextWindow": 272000,
          "maxTokens": 128000,
          "input": ["text", "image"],
          "applyPatchToolType": "freeform",
          "reasoning": true,
          "thinkingLevelMap": {"xhigh": "xhigh", "max": "max"},
          "cost": {"input": 5, "output": 30, "cacheRead": 0.5, "cacheWrite": 6.25, "tiers": [{"inputTokensAbove": 272000, "input": 10, "output": 45, "cacheRead": 1, "cacheWrite": 12.5}]}
        },
        {
          "id": "gpt-5.6-terra",
          "name": "GPT-5.6 Terra",
          "contextWindow": 272000,
          "maxTokens": 128000,
          "input": ["text", "image"],
          "applyPatchToolType": "freeform",
          "reasoning": true,
          "thinkingLevelMap": {"xhigh": "xhigh", "max": "max"},
          "cost": {"input": 2, "output": 12, "cacheRead": 0.2, "cacheWrite": 2.5, "tiers": [{"inputTokensAbove": 272000, "input": 4, "output": 18, "cacheRead": 0.4, "cacheWrite": 5}]}
        }
      ]
    }
  ],
  "runtime": {
    "kind": "rpc",
    "command": "uv",
    "args": ["run", "--project", ".", "main.py"]
  }
}
