{
  "name": "deep-web-search",
  "version": "0.1.0",
  "description": "Four-provider parallel web search with source cleaning, content extraction, evidence checks, and automatic summary fallback.",
  "capabilities": ["tool", "settings"],
  "i18n": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "zh": "locales/zh.json"
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exaApiKey": {"type": "string", "secret": true, "description": "Optional Exa API key. Without it, Exa MCP is used."},
        "exaMode": {"type": "string", "enum": ["auto", "api", "mcp"], "description": "Exa transport selection."},
        "tinyfishApiKey": {"type": "string", "secret": true, "description": "TinyFish API key from the TinyFish console."},
        "codexModel": {"type": "string", "description": "Codex model used by the web-search provider."},
        "provider": {"type": "string", "enum": ["auto", "all", "codex", "exa", "tinyfish", "duckduckgo"], "description": "Default provider selection."},
        "providerToggles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codex": {"type": "boolean"},
            "exa": {"type": "boolean"},
            "tinyfish": {"type": "boolean"},
            "duckduckgo": {"type": "boolean"}
          }
        },
        "maxResults": {"type": "integer", "description": "Maximum distinct sources returned by one query."},
        "fetchContent": {"type": "boolean", "description": "Fetch source bodies in the background."},
        "summaryModel": {"type": "string", "description": "Model spec such as openai-codex/gpt-5.5; empty disables model summaries."},
        "summaryGenerationDeadlineMs": {"type": "integer", "description": "Summary generation deadline in milliseconds."},
        "workflow": {"type": "string", "enum": ["none", "auto-summary"], "description": "Result workflow selected by the user."}
      }
    },
    "defaults": {
      "exaMode": "auto",
      "codexModel": "gpt-5.5",
      "provider": "all",
      "providerToggles": {"codex": true, "exa": true, "tinyfish": true, "duckduckgo": true},
      "maxResults": 5,
      "fetchContent": false,
      "summaryModel": "openai-codex/gpt-5.5",
      "summaryGenerationDeadlineMs": 30000,
      "workflow": "none"
    }
  },
  "runtime": {
    "kind": "rpc",
    "command": "node",
    "args": ["dist/main.js"],
    "install": ["npm", "run", "build"]
  }
}
